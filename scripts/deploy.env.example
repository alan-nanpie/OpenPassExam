# ==============================================================================
# PassExam - Cloud Run 自動發布環境設定範本 (deploy.env.example)
#
# 說明：
# 1. 本檔案為範本檔，可安全提交至 GitHub 公開倉庫。
# 2. 實際使用時，請複製本檔案為「deploy.env」：
#    Copy-Item scripts/deploy.env.example scripts/deploy.env
# 3. 填寫您專屬的 GCP 專案 ID 與設定。
# 4. 「deploy.env」已由 .gitignore 嚴格排除，絕對不會上傳至 GitHub，請安心使用！
# ==============================================================================

# 【必填】您的 Google Cloud 專案 ID (例如：my-passexam-app-123456)
GCP_PROJECT_ID=your-gcp-project-id

# 【選填】部署區域 (預設為台灣 asia-east1，亦可改為 us-central1、asia-northeast1 等)
GCP_REGION=asia-east1

# 【選填】Artifact Registry 容器存放庫名稱 (預設：openpassexam-repo)
REPO_NAME=openpassexam-repo

# 【選填】Cloud Run 服務名稱 (預設：openpassexam-web)
SERVICE_NAME=openpassexam-web

# 【選填】映像檔版本標籤 (預設：latest)
IMAGE_TAG=latest

# 【選填】Cloud Run 實例記憶體限制 (預設：512Mi，高用量可改為 1Gi 或 2Gi)
MEMORY_LIMIT=512Mi

# 【選填】Cloud Run 實例 CPU 限制 (預設：1)
CPU_LIMIT=1
